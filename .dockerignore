# --- Build hygiene: keep the image small and the context clean ---
# Version control & CI
.git/
.gitignore
.github/

# Python virtualenvs & caches
.venv/
venv/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local SQLite databases (must NOT leak into the image; created at runtime)
*.db
*.db-wal
*.db-shm
notes.db*

# Tests and docs are not needed to build or run the API.
# (src/ IS needed — the build stage installs the package from it.)
tests/
docs/

# Secrets & local env
.env
.env.*
!.env.example

# Agent/tooling state (uv.lock stays IN the context — the uv build stage
# installs the frozen dependency set from it)
.ada_data/
workspace/

# Editor / OS cruft
.DS_Store
*.swp
.idea/
.vscode/

# Build artifacts
dist/
build/
